     if use_compiler_launcher && let Some(ref ccache) = builder.config.ccache {
@@ -801,7 +809,11 @@
         cflags.push(s);
     }
     if target.contains("ohos") {
+        cflags.push(format!(" --target={target}"));
+        cflags.push(" --sysroot=/opt/ohos-sdk/native/sysroot");
         cflags.push(" -D_LINUX_SYSINFO_H");
+        cflags.push(" -D_UAPI_LINUX_SOCKET_H");
+        cflags.push(" -fuse-ld=lld");
+        cflags.push(" -fno-emulated-tls");
+        cflags.push(" -gz=none");
     }
     if builder.config.llvm_clang_cl.is_some() {
         cflags.push(format!(" --target={target}"));
@@ -826,7 +838,11 @@
         cxxflags.push(s);
     }
     if target.contains("ohos") {
+        cxxflags.push(format!(" --target={target}"));
+        cxxflags.push(" --sysroot=/opt/ohos-sdk/native/sysroot");
+        cxxflags.push(" -D_LINUX_SYSINFO_H");
+        cxxflags.push(" -D_UAPI_LINUX_SOCKET_H");
+        cxxflags.push(" -fuse-ld=lld");
+        cxxflags.push(" -fno-emulated-tls");
+        cxxflags.push(" -gz=none");
     }
     if builder.config.llvm_clang_cl.is_some() {
         cxxflags.push(format!(" --target={target}"));
@@ -871,6 +887,13 @@
         }
     }
 
+    if target.contains("ohos") {
+        ldflags.push_all(format!(" --target={target}"));
+        ldflags.push_all(" --sysroot=/opt/ohos-sdk/native/sysroot");
+        ldflags.push_all(" -fuse-ld=lld");
+        ldflags.push_all("-Wl,--code-sign");
+    }
