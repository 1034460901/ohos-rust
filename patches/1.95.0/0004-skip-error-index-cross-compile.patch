     fn make_run(run: RunConfig<'_>) {
+        // Skip error index generation when cross-compiling.
+        // The error_index_generator tool must be executed on the build host,
+        // but IS_HOST causes it to be built for the --host target.
+        if run.target != run.builder.host_target {
+            return;
+        }
         run.builder.ensure(ErrorIndex {
             compilers: RustcPrivateCompilers::new(run.builder, run.builder.top_stage, run.target),
         });
