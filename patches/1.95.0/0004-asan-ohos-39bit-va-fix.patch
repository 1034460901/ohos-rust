From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2000
From: OHOS Rust <ohos-rust@example.com>
Date: Thu, 13 Aug 2026 00:00:00 +0000
Subject: [PATCH] OHOS sanitizer: ASAN/HWASAN/LSAN 39-bit VA + clang/sysroot/personality fixes

Combined sanitizer fixes for OHOS aarch64 (39-bit VA):

1. ASAN/HWASAN/LSAN allocator size:
   - Add SANITIZER_OHOS macro in sanitizer_platform.h
   - ASAN: use 128GB allocator (kAllocatorSize=0x2000000000) for OHOS
     (default 4TB exceeds OHOS 39-bit VA / 512GB user space)
   - HWASAN: skip 4TB allocator for OHOS, fall through to 128GB path
   - LSAN: add SANITIZER_OHOS to aarch64 branch (backport from 1.100.0)

2. Sanitizer CMake clang override:
   - Use OHOS SDK clang/clang++ for sanitizer builds
   - Add -fuse-ld=lld to cflags/cxxflags (required for --code-sign)
   - Add -fno-emulated-tls and -gz=none to cflags/cxxflags

3. Sanitizer sysinfo + socket + target/sysroot:
   - Add --target and --sysroot to cflags/cxxflags/ldflags
     (OHOS SDK clang defaults to host target without --target)
   - Add -D_UAPI_LINUX_SOCKET_H to prevent sockaddr_storage redefinition
   - Add ldflags OHOS block (--target, --sysroot, -fuse-ld=lld, -Wl,--code-sign)
   - Include <sys/sysinfo.h> at top of sanitizer_platform_limits_posix.cpp
     (bionic guards struct sysinfo with #ifndef _LINUX_KERNEL_H; must
     include before any header that defines _LINUX_KERNEL_H)

4. __gcc_personality_v0 stub (backport from 1.100.0):
   - New file sanitizer_gcc_personality_v0.cpp
   - Add to sanitizer_common/CMakeLists.txt source list
   - OHOS SDK has no libgcc_eh.a; stub satisfies linker references

---

diff --git a/src/llvm-project/compiler-rt/lib/sanitizer_common/sanitizer_platform.h b/src/llvm-project/compiler-rt/lib/sanitizer_common/sanitizer_platform.h
--- a/src/llvm-project/compiler-rt/lib/sanitizer_common/sanitizer_platform.h
+++ b/src/llvm-project/compiler-rt/lib/sanitizer_common/sanitizer_platform.h
@@ -136,6 +136,13 @@
 #  define SANITIZER_ANDROID 0
 #endif
 
+
+#if defined(__OHOS__)
+#  define SANITIZER_OHOS 1
+#else
+#  define SANITIZER_OHOS 0
+#endif
+
 #if defined(__Fuchsia__)
 #  define SANITIZER_FUCHSIA 1
 #else
diff --git a/src/llvm-project/compiler-rt/lib/asan/asan_allocator.h b/src/llvm-project/compiler-rt/lib/asan/asan_allocator.h
--- a/src/llvm-project/compiler-rt/lib/asan/asan_allocator.h
+++ b/src/llvm-project/compiler-rt/lib/asan/asan_allocator.h
@@ -205,7 +205,8 @@
 #      endif
 typedef DefaultSizeClassMap SizeClassMap;
 #    elif defined(__aarch64__) && \
-        (SANITIZER_ANDROID || defined(SANITIZER_AARCH64_39BIT_VA))
+        (SANITIZER_ANDROID || defined(SANITIZER_AARCH64_39BIT_VA) || \
+         SANITIZER_OHOS)
 // Android needs to support 39, 42 and 48 bit VMA.
 const uptr kAllocatorSize  =  0x2000000000ULL;  // 128G.
 typedef VeryCompactSizeClassMap SizeClassMap;
diff --git a/src/llvm-project/compiler-rt/lib/hwasan/hwasan_allocator.h b/src/llvm-project/compiler-rt/lib/hwasan/hwasan_allocator.h
--- a/src/llvm-project/compiler-rt/lib/hwasan/hwasan_allocator.h
+++ b/src/llvm-project/compiler-rt/lib/hwasan/hwasan_allocator.h
@@ -75,7 +75,7 @@
   static const uptr kSpaceSize = 1ULL << kAddressTagShift;
   typedef __sanitizer::DefaultSizeClassMap SizeClassMap;
 #elif SANITIZER_LINUX && !SANITIZER_ANDROID && \
-    !defined(SANITIZER_AARCH64_39BIT_VA)
+    !defined(SANITIZER_AARCH64_39BIT_VA) && !SANITIZER_OHOS
   static const uptr kSpaceSize = 0x40000000000ULL;  // 4T.
   typedef __sanitizer::DefaultSizeClassMap SizeClassMap;
 #else
diff --git a/src/llvm-project/compiler-rt/lib/lsan/lsan_allocator.h b/src/llvm-project/compiler-rt/lib/lsan/lsan_allocator.h
--- a/src/llvm-project/compiler-rt/lib/lsan/lsan_allocator.h
+++ b/src/llvm-project/compiler-rt/lib/lsan/lsan_allocator.h
@@ -93,7 +93,7 @@
 const uptr kAllocatorSpace = 0x600000000000ULL;
 const uptr kAllocatorSize  = 0x40000000000ULL;  // 4T.
 using LSanSizeClassMap = DefaultSizeClassMap;
-#  elif SANITIZER_ANDROID && defined(__aarch64__)
+#  elif (SANITIZER_ANDROID || SANITIZER_OHOS) && defined(__aarch64__)
 const uptr kAllocatorSpace = 0x3000000000ULL;
 const uptr kAllocatorSize = 0x2000000000ULL;
 using LSanSizeClassMap = VeryCompactSizeClassMap;
diff --git a/src/llvm-project/compiler-rt/lib/sanitizer_common/sanitizer_gcc_personality_v0.cpp b/src/llvm-project/compiler-rt/lib/sanitizer_common/sanitizer_gcc_personality_v0.cpp
new file mode 100644
--- /dev/null
+++ b/src/llvm-project/compiler-rt/lib/sanitizer_common/sanitizer_gcc_personality_v0.cpp
+//===-- sanitizer_gcc_personality_v0.cpp ----------------------------------===//
+//
+// OHOS: Provide __gcc_personality_v0 stub for sanitizer archives.
+// OHOS SDK has no libgcc_eh.a or libunwind.a; this stub satisfies linker
+// references from C++ EH tables without requiring unwind runtime.
+// Safe because sanitizers never actually throw C++ exceptions (they call
+// Die() instead). The personality function is never called at runtime.
+//
+//===----------------------------------------------------------------------===//
+
+#if defined(__OHOS__)
+
+#include <stdint.h>
+
+typedef enum {
+  _URC_NO_REASON = 0,
+  _URC_FOREIGN_EXCEPTION_CAUGHT = 1,
+  _URC_FATAL_PHASE2_ERROR = 2,
+  _URC_FATAL_PHASE1_ERROR = 3,
+  _URC_NORMAL_STOP = 4,
+  _URC_END_OF_STACK = 5,
+  _URC_HANDLER_FOUND = 6,
+  _URC_INSTALL_CONTEXT = 7,
+  _URC_CONTINUE_UNWIND = 8
+} _Unwind_Reason_Code;
+
+struct _Unwind_Exception;
+struct _Unwind_Context;
+
+extern "C" _Unwind_Reason_Code __gcc_personality_v0(int version, int actions,
+    uint64_t exception_class, struct _Unwind_Exception *ue_header,
+    struct _Unwind_Context *context) {
+  return _URC_CONTINUE_UNWIND;
+}
+
+#endif // __OHOS__
diff --git a/src/llvm-project/compiler-rt/lib/sanitizer_common/CMakeLists.txt b/src/llvm-project/compiler-rt/lib/sanitizer_common/CMakeLists.txt
--- a/src/llvm-project/compiler-rt/lib/sanitizer_common/CMakeLists.txt
+++ b/src/llvm-project/compiler-rt/lib/sanitizer_common/CMakeLists.txt
@@ -45,6 +45,7 @@
   sanitizer_type_traits.cpp
   sanitizer_win.cpp
   sanitizer_win_interception.cpp
+  sanitizer_gcc_personality_v0.cpp
   )
 
 set(SANITIZER_SOURCES
diff --git a/src/bootstrap/src/core/build_steps/llvm.rs b/src/bootstrap/src/core/build_steps/llvm.rs
--- a/src/bootstrap/src/core/build_steps/llvm.rs
+++ b/src/bootstrap/src/core/build_steps/llvm.rs
@@ -762,6 +762,13 @@
         None => (builder.cc(target), builder.cxx(target).unwrap()),
     };
 
+    let (cc, cxx) = if target.contains("ohos") {
+        let sdk = std::path::Path::new("/opt/ohos-sdk/native/llvm/bin");
+        (sdk.join("clang"), sdk.join("clang++"))
+    } else {
+        (cc, cxx)
+    };
+
     // If ccache is configured we inform the build a little differently how
     // to invoke ccache while also invoking our compilers.
     if use_compiler_launcher && let Some(ref ccache) = builder.config.ccache {
@@ -801,7 +808,13 @@
         cflags.push(s);
     }
     if target.contains("ohos") {
+        cflags.push(format!(" --target={target}"));
+        cflags.push(" --sysroot=/opt/ohos-sdk/native/sysroot");
         cflags.push(" -D_LINUX_SYSINFO_H");
+        cflags.push(" -D_UAPI_LINUX_SOCKET_H");
+        cflags.push(" -fuse-ld=lld");
+        cflags.push(" -fno-emulated-tls");
+        cflags.push(" -gz=none");
     }
     if builder.config.llvm_clang_cl.is_some() {
         cflags.push(format!(" --target={target}"));
@@ -826,13 +839,25 @@
         cxxflags.push(s);
     }
     if target.contains("ohos") {
+        cxxflags.push(format!(" --target={target}"));
+        cxxflags.push(" --sysroot=/opt/ohos-sdk/native/sysroot");
         cxxflags.push(" -D_LINUX_SYSINFO_H");
+        cxxflags.push(" -D_UAPI_LINUX_SOCKET_H");
+        cxxflags.push(" -fuse-ld=lld");
+        cxxflags.push(" -fno-emulated-tls");
+        cxxflags.push(" -gz=none");
     }
     if builder.config.llvm_clang_cl.is_some() {
         cxxflags.push(format!(" --target={target}"));
     }
 
     cfg.define("CMAKE_CXX_FLAGS", cxxflags);
+    if target.contains("ohos") {
+        cfg.define(
+            "CMAKE_ASM_FLAGS",
+            format!(" --target={target} --sysroot=/opt/ohos-sdk/native/sysroot -D_UAPI_LINUX_SOCKET_H -fuse-ld=lld"),
+        );
+    }
     if let Some(ar) = builder.ar(target)
         && ar.is_absolute()
     {
@@ -872,6 +897,9 @@
     }
 
     if target.contains("ohos") {
+        ldflags.push_all(format!(" --target={target}"));
+        ldflags.push_all(" --sysroot=/opt/ohos-sdk/native/sysroot");
+        ldflags.push_all(" -fuse-ld=lld");
         ldflags.push_all("-Wl,--code-sign");
     }
 
@@ -1460,6 +1488,7 @@
 
         if self.target.contains("ohos") {
             cfg.define("COMPILER_RT_USE_BUILTINS_LIBRARY", "ON");
+            cfg.define("SANITIZER_AARCH64_39BIT_VA", "ON");
         }
 
         // On Darwin targets the sanitizer runtimes are build as universal binaries.
diff --git a/src/llvm-project/compiler-rt/lib/sanitizer_common/sanitizer_platform_limits_posix.cpp b/src/llvm-project/compiler-rt/lib/sanitizer_common/sanitizer_platform_limits_posix.cpp
--- a/src/llvm-project/compiler-rt/lib/sanitizer_common/sanitizer_platform_limits_posix.cpp
+++ b/src/llvm-project/compiler-rt/lib/sanitizer_common/sanitizer_platform_limits_posix.cpp
@@ -307,6 +307,12 @@
   unsigned struct_statvfs64_sz = sizeof(struct statvfs64);
 #endif // SANITIZER_GLIBC
 
+#if SANITIZER_LINUX && !SANITIZER_GLIBC && !SANITIZER_ANDROID
+// musl-based Linux (OHOS, Alpine, etc.) — struct rlimit64 is available
+// via sys/resource.h (may be #define'd to struct rlimit on musl)
+unsigned struct_rlimit64_sz = sizeof(struct rlimit64);
+#endif
+
 #if SANITIZER_LINUX && !SANITIZER_ANDROID
   unsigned struct_timex_sz = sizeof(struct timex);
   unsigned struct_msqid_ds_sz = sizeof(struct msqid_ds);
